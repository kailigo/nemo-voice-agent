# Stock-voice overrides for the tau2 voice personas. Source this before `tau2 run`.
#
# WHY THIS EXISTS
# The seven official tau-bench voice ids hardcoded in
# tau-voice-2/src/tau2/data_model/voice_personas.py are PRIVATE voices in Sierra's
# ElevenLabs account. Every one of them returns 404 voice_not_found on our key
# (all 7 checked individually, 2026-08-18). Without an override the user simulator
# cannot synthesize a single turn, so no episode can run at all.
#
# COMPARABILITY WARNING
# These are the 22 stock ElevenLabs library voices, not the official ones. tau2 itself
# warns about this: "Results produced with non-official voices are NOT comparable to
# the official leaderboard." Use these for integration testing and for A/B/C comparisons
# among our own arms. Do NOT publish a number against the Gemini/OpenAI tau-voice
# baselines from a run that sourced this file.
#
# The two `control` personas (matt_delaney, lisa_brenner) are the default speech
# complexity and are plain American English, so stock voices distort them least.
# The five `regular` personas are defined by non-native accents (Bengali, Sichuan
# Mandarin, French/Senegalese, Maharashtrian) that NO stock voice reproduces -- those
# substitutions change the acoustic condition the model is being tested on, which is
# most of what the `regular` set is there to measure. Treat regular-complexity results
# from this file as meaningless, not merely non-official.

# --- control complexity (default) ---
# Middle-aged US Midwest man, calm and respectful
export TAU2_VOICE_ID_MATT_DELANEY=cjVigY5qzO86Huf0OWal   # Eric - Smooth, Trustworthy
# White woman in her late 40s, tense and impatient
export TAU2_VOICE_ID_LISA_BRENNER=EXAVITQu4vr4xnSDxMaL    # Sarah - Mature, Reassuring, Confident

# --- regular complexity (accent NOT reproduced; see warning above) ---
export TAU2_VOICE_ID_MILDRED_KAPLAN=XrExE9yKIg1WjnnlVkGX  # Matilda - Knowledgable, Professional
export TAU2_VOICE_ID_ARJUN_ROY=IKne3meq5aSn9XLyUdCD       # Charlie - Deep, Confident, Energetic
export TAU2_VOICE_ID_WEI_LIN=FGY2WhTYpPnrIDTdsKH5         # Laura - Enthusiast, Quirky Attitude
export TAU2_VOICE_ID_MAMADOU_DIALLO=CwhRBWXzGAHq8TQ4Fs17  # Roger - Laid-Back, Casual, Resonant
export TAU2_VOICE_ID_PRIYA_PATIL=cgSgspJ2msm6clMCkdW9     # Jessica - Playful, Bright, Warm
